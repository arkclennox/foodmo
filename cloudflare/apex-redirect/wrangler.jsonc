{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Deploy: npx wrangler deploy -c cloudflare/apex-redirect/wrangler.jsonc
  "name": "foodmo-apex-redirect",
  "main": "index.js",
  "compatibility_date": "2026-10-15",
  "routes": [{ "pattern": "foodmo.id", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
